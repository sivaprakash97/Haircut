{
  "name": "haircut-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based 3D hair sculpting sandbox: hair is sculptable clay.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/check-size.mjs",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run size"
  },
  "dependencies": {
    "preact": "11.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
